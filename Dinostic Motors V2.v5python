{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nmotor_1 = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nmotor_2 = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nmotor_3 = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\nmotor_4 = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)\nmotor_5 = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)\nmotor_6 = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)\nmotor_7 = Motor(Ports.PORT7, GearSetting.RATIO_18_1, False)\nmotor_8 = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\nmotor_9 = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)\nmotor_10 = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)\nmotor_11 = Motor(Ports.PORT11, GearSetting.RATIO_18_1, False)\nmotor_12 = Motor(Ports.PORT12, GearSetting.RATIO_18_1, False)\nmotor_13 = Motor(Ports.PORT13, GearSetting.RATIO_18_1, False)\nmotor_14 = Motor(Ports.PORT14, GearSetting.RATIO_18_1, False)\nmotor_15 = Motor(Ports.PORT15, GearSetting.RATIO_18_1, False)\nmotor_16 = Motor(Ports.PORT16, GearSetting.RATIO_18_1, False)\nmotor_21 = Motor(Ports.PORT21, GearSetting.RATIO_18_1, False)\nmotor_17 = Motor(Ports.PORT17, GearSetting.RATIO_18_1, False)\nmotor_18 = Motor(Ports.PORT18, GearSetting.RATIO_18_1, False)\nmotor_19 = Motor(Ports.PORT19, GearSetting.RATIO_18_1, False)\nmotor_20 = Motor(Ports.PORT20, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       Micah Bow\n#\tCreated:      11/24/2025\n#\tDescription:  Motor And General Heath Dinostics\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n# Begin project code\n\nC_print=controller_1.screen.print\nb_print=brain.screen.print\n\n#Variable for motors\nmotors=MotorGroup(motor_1,motor_2,motor_3,motor_4,motor_5,motor_6,motor_7,motor_8,motor_9,motor_10,motor_11,motor_12,motor_13,motor_14,motor_15,motor_16,motor_17,motor_18,motor_19,motor_20)\nmots=[motor_1,motor_2,motor_3,motor_4,motor_5,motor_6,motor_7,motor_8,motor_9,motor_10,motor_11,motor_12,motor_13,motor_14,motor_15,motor_16,motor_17,motor_18,motor_19,motor_20]\nmots_installed=[]\n# motor letter defineing\nfor M in range(0,21):\n    if mots[M] .installed():\n        mots_installed .append(mots[M])\n\nbrain.screen.set_font(FontType.MONO12)\nbrain.screen.set_fill_color(Color.BLACK)\n\n#loop for printing of health\nwhile 1==0:\n\n        #watt convertion for battery\n\n        battery_watts=brain.battery.voltage(VoltageUnits.VOLT)*brain.battery.current(CurrentUnits.AMP)\n\n        #print for controller_1\n\n        #print for motor installation\n        for I in range(0,21):\n            C_print(\"{mots[I]} installed? {mots[I] .installed()}\")\n        controller_1.screen.next_row()\n\n        #print for motor health and temps\n        C_print(\"Motors Health And Temps:\")\n        for H in range(0,len(mots_installed)):\n        if mots_installed[H] .temperature(PERCENT)>=60:\n            C_print(\"{mots_installed} To Hot\")\n        else:\n            C_print({\"{mots_installed} ok\"})\n        controller_1.screen.next_row()\n\n        C_print(\"motors average effiicency: {motors.efficiency(PERCENT)}\")\n        controller_1.screen.next_row()\n\n        #battery health and power use\n        C_print(\"Battery health and power use\")\n        C_print(\"Battery Voltage: {brain.battery.voltage(VoltageUnits.VOLT)}\")\n        C_print(\"Battery current: {brain.battery.current(CurrentUnits.AMP)}\")\n        C_print(\"Battery watts: {battery_watts}\")\n        \n        #brain print\n\n         #print for motor installation\n        for I in range(0,21):\n            b_print(\"{mots[I]} installed? {mots[I] .installed()}\")\n        brain.screen.next_row()\n\n        #print for motor health and temps\n        b_print(\"Motors Health And Temps:\")\n        for H in range(0,len(mots_installed)):\n        if mots_installed[H] .temperature(PERCENT)>=60:\n            C_print(\"{mots_installed} To Hot\")\n        else:\n            C_print({\"{mots_installed} ok\"})\n        brain.screen.next_row()\n\n        b_print(\"motors average effiicency: {motors.efficiency(PERCENT)}\")\n        brain.screen.next_row()\n\n        #battery health and power use\n        b_print(\"Battery health and power use\")\n        b_print(\"Battery Voltage: {brain.battery.voltage(VoltageUnits.VOLT)}\")\n        b_print(\"Battery current: {brain.battery.current(CurrentUnits.AMP)}\")\n        b_print(\"Battery watts: {battery_watts}\")\n\n        #screen refresh\n        wait(250,MSEC)\n        controller_1.screen.clear_screen()\n        brain.screen.clear_screen()\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[1],"name":"motor_1","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"motor_2","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[3],"name":"motor_3","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[4],"name":"motor_4","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[5],"name":"motor_5","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[6],"name":"motor_6","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[7],"name":"motor_7","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[8],"name":"motor_8","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[9],"name":"motor_9","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[10],"name":"motor_10","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[11],"name":"motor_11","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[12],"name":"motor_12","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[13],"name":"motor_13","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[14],"name":"motor_14","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[15],"name":"motor_15","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[16],"name":"motor_16","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[21],"name":"motor_21","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[17],"name":"motor_17","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[18],"name":"motor_18","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[19],"name":"motor_19","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[20],"name":"motor_20","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22}],"slot":7,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}