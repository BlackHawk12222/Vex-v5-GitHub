{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nIntake_Motor = Motor(Ports.PORT14, GearSetting.RATIO_6_1, False)\nLeft_1 = Motor(Ports.PORT20, GearSetting.RATIO_18_1, False)\nLeft_2 = Motor(Ports.PORT19, GearSetting.RATIO_18_1, False)\nLeft_3 = Motor(Ports.PORT18, GearSetting.RATIO_18_1, False)\nRight_1 = Motor(Ports.PORT11, GearSetting.RATIO_18_1, False)\nRight_2 = Motor(Ports.PORT13, GearSetting.RATIO_18_1, False)\nRight_3 = Motor(Ports.PORT12, GearSetting.RATIO_18_1, False)\nTop_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nColor_sort = Motor(Ports.PORT15, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# Library imports\nfrom vex import *\n\n# Begin project code\ndef Motor_health (Motor_type,Motor_Port):\n        Motor_type.spin(FORWARD)\n        motor_temps=0\n        motor_efficiency=0\n        brain.screen.set_cursor(1, 1)\n        B_print(\"testing motor funtion...  \")\n        if Motor_type.temperature(PERCENT)<=80:\n            motor_temps=0\n        elif Motor_type.temperature(PERCENT)>80 and Motor_type.temperature(PERCENT) <= 90:\n            motor_temps=1\n        else:\n            motor_temps=2\n        if Motor_type.efficiency(PERCENT)>= 40:\n            motor_efficiency=0\n        elif Motor_type.efficiency(PERCENT)<40 and Motor_type.efficiency(PERCENT)>20:\n            motor_efficiency=1\n        else:\n            motor_efficiency=2\n        brain.screen.clear_row(1)\n        if motor_temps==0 and motor_efficiency==0:\n            B_print(Motor_type , \" Health is OK\")\n        elif (motor_temps==1 and motor_efficiency==0) or (motor_temps==0 and motor_efficiency==1):\n            if motor_temps==1:\n                B_print(Motor_type , \" HOT\")\n            if motor_efficiency==1:\n                B_print(Motor_type+\" INEFFICIENT\")\n        elif motor_temps==1 and motor_efficiency==1:\n            B_print(Motor_type , \" Under To Much Load\")\n        elif motor_temps==2 or motor_efficiency==2:\n            B_print(Motor_type , \" CRITICAL!!!\")\n        Motor_type.stop()\n\ndef Motor_script():\n\n    Motor_health (Intake_Motor,14)\n    Motor_health (Color_sort, 15)\n    Motor_health (Top_motor, 1)\n    wait(10, SECONDS)\n    B_print(\" Do drivetrain? Press A on Controller for yes or press B for no\")\n    if controller_1.buttonB.pressing():\n        mode=0\n    elif controller_1.buttonA.pressing():\n        Motor_health(Left_1,20)\n        Motor_health(Left_2,19)\n        Motor_health(Left_3,18)\n        Motor_health(Right_1,11)\n        Motor_health(Right_2,13)\n        Motor_health(Right_3,12)\n        \n        mode=0\n\n\n\nB_print=brain.screen.print\nB_new_line=brain.screen.next_row\nMotor_script()","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[14],"name":"Intake_Motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[20],"name":"Left_1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[19],"name":"Left_2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[18],"name":"Left_3","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[11],"name":"Right_1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[13],"name":"Right_2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[12],"name":"Right_3","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[1],"name":"Top_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[15],"name":"Color_sort","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22}],"slot":7,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}