print(\"19       Left_2: \", Left2.temperature(PERCENT), Left2.power(PowerUnits.WATT), Left2.torque(TorqueUnits.NM), Left2.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"18       Left_3: \", Left3.temperature(PERCENT), Left3.power(PowerUnits.WATT), Left3.torque(TorqueUnits.NM), Left3.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"11      Right_1: \", Right1.temperature(PERCENT), Right1.power(PowerUnits.WATT), Right1.torque(TorqueUnits.NM), Right1.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"13      Right_2: \", Right2.temperature(PERCENT), Right2.power(PowerUnits.WATT), Right2.torque(TorqueUnits.NM), Right2.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"12      Right_3: \", Right3.temperature(PERCENT), Right3.power(PowerUnits.WATT), Right3.torque(TorqueUnits.NM), Right3.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"15    Colorsort: \", colorsorting.temperature(PERCENT), colorsorting.power(PowerUnits.WATT), colorsorting.torque(TorqueUnits.NM), colorsorting.efficiency(PERCENT)), B_new_line()&amp;#10;&amp;#10;B_print(\"1     Top_motor: \", TopMotor.temperature(PERCENT), TopMotor.power(PowerUnits.WATT), TopMotor.torque(TorqueUnits.NM), TopMotor.efficiency(PERCENT)), B_new_line()&amp;#10;    &amp;#10;B_print(\"inertal sensor data: rotation: \", inertial_for_auton.rotation(DEGREES))&amp;#10;&amp;#10;brain.screen.render()&amp;#10;wait(100,MSEC)</field></block></statement><next><block type=\"v5_screen_clear_all_rows\" id=\"@RTb35`TzM$7.jcHr$dI\"></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block><block type=\"procedures_definition\" id=\"#gz0#5xS%U90V$m#,OeX\" x=\"1350\" y=\"3030\"><statement name=\"custom_block\"><shadow type=\"procedures_prototype\" id=\"rv)ApUswtUv3WP`/TB3.\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" proccode=\"Turn Degrees %n Right or left %n\" proceduredefid=\"rv)ApUswtUv3WP`/TB3.\" argumentids=\"[&quot;4U`aax6V]Fo1f~a;HtC|&quot;,&quot;b*Q%lQO$pc8r]jx]C/Ir&quot;]\" argumentnames=\"[&quot;Degrees&quot;,&quot;R/L&quot;]\" argumentdefaults=\"[&quot;todo&quot;,&quot;todo&quot;]\" argumenttypes=\"[&quot;n&quot;,&quot;n&quot;]\" warp=\"false\"></mutation><value name=\"4U`aax6V]Fo1f~a;HtC|\"><shadow type=\"argument_reporter_number\" id=\"GFoqA*QlJ#zgSZ^6i/L)\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" funcname=\"Turn_Degrees_Degrees_Right_or_left_R/L\" argumentid=\"4U`aax6V]Fo1f~a;HtC|\" proceduredefid=\"rv)ApUswtUv3WP`/TB3.\"></mutation><field name=\"VALUE\">Degrees</field></shadow></value><value name=\"b*Q%lQO$pc8r]jx]C/Ir\"><shadow type=\"argument_reporter_number\" id=\".1^Ok98BfZoNEd3=jRzZ\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" funcname=\"Turn_Degrees_Degrees_Right_or_left_R/L\" argumentid=\"b*Q%lQO$pc8r]jx]C/Ir\" proceduredefid=\"rv)ApUswtUv3WP`/TB3.\"></mutation><field name=\"VALUE\">R/L</field></shadow></value></shadow></statement><next><block type=\"mixed_multiline_command\" id=\"A({|o^jp4BEnBp%9e2u|\"><field name=\"MULTILINE_INPUT\">inertial_for_auton.set_rotation(0, DEGREES)&amp;#10;# Ratio for Degrees of robot turn to degrees or motor turn (turns both sides of drivetrain)&amp;#10;degrees_to_Degrees = Turn_Degrees_Degrees_Right_or_left_R_L__Degrees * 2.11&amp;#10;wait(10, MSEC)&amp;#10;if Turn_Degrees_Degrees_Right_or_left_R_L__R_L == \"r\" or Turn_Degrees_Degrees_Right_or_left_R_L__R_L == \"R\":&amp;#10;    Drive_Right_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"r\")&amp;#10;    Drive_left_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"f\")&amp;#10;    # using inertial to see how off it is&amp;#10;    print(\"\\033[33m\")&amp;#10;    print(str(\"Turn Off by: \") + str(inertial_for_auton.rotation(DEGREES) - Turn_Degrees_Degrees_Right_or_left_R_L__Degrees))&amp;#10;    while not Right1.is_done():&amp;#10;        wait(5, MSEC)&amp;#10;    for repeat_count in range(5):&amp;#10;        degrees_to_Degrees = Turn_Degrees_Degrees_Right_or_left_R_L__Degrees - inertial_for_auton.rotation(DEGREES)&amp;#10;        Drive_Right_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"r\")&amp;#10;        Drive_left_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"f\")&amp;#10;        print(\"\\033[91m\")&amp;#10;        print(str(\"Inertial Turn off By: \") + str(inertial_for_auton.rotation(DEGREES) + Turn_Degrees_Degrees_Right_or_left_R_L__Degrees))&amp;#10;        while not Right1.is_done():&amp;#10;            wait(5, MSEC)&amp;#10;        wait(5, MSEC)&amp;#10;elif Turn_Degrees_Degrees_Right_or_left_R_L__R_L == \"l\" or Turn_Degrees_Degrees_Right_or_left_R_L__R_L == \"L\":&amp;#10;    Drive_Right_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"f\")&amp;#10;    Drive_left_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"r\")&amp;#10;    # using inertial to see how off it is&amp;#10;    print(\"\\033[33m\")&amp;#10;    print(str(\"Turn Off By: \") + str(inertial_for_auton.rotation(DEGREES) - Turn_Degrees_Degrees_Right_or_left_R_L__Degrees * -1))&amp;#10;    while not Right1.is_done():&amp;#10;        wait(5, MSEC)&amp;#10;    for repeat_count2 in range(5):&amp;#10;        degrees_to_Degrees = inertial_for_auton.rotation(DEGREES) - Turn_Degrees_Degrees_Right_or_left_R_L__Degrees&amp;#10;        Drive_Right_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"f\")&amp;#10;        Drive_left_degrees_degrees_Forward_Reverse_F_R(degrees_to_Degrees, \"r\")&amp;#10;        print(\"\\033[91m\")&amp;#10;        print(str(\"Inertial Turn Off by: \") + str(inertial_for_auton.rotation(DEGREES) - Turn_Degrees_Degrees_Right_or_left_R_L__Degrees * -1))&amp;#10;        while not Right1.is_done():&amp;#10;            wait(5, MSEC)&amp;#10;        wait(5, MSEC)&amp;#10;else:&amp;#10;    print(\"\\033[31m\")&amp;#10;    print(\"ERROR Drive malfuntion Turn R/L\")</field></block></next></block><block ty